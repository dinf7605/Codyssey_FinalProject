# ============================================
# StudyPace — 환경변수 템플릿
# 사용법: 이 파일을 복사해 .env 로 만들고 값을 채운다
#   $ cp .env.example .env
# 주의: .env 는 절대 커밋하지 않는다 (.gitignore가 막고 있음)
# ============================================

# ── 앱 기본 설정 ──
APP_ENV=development          # development / production
PORT=8000                   # FastAPI 서버 포트

# ── CORS (프론트 도메인 허용 목록) ──
# 로컬 개발 시 Next.js 기본 포트. 배포 후 Vercel 주소 추가
FRONTEND_ORIGIN=http://localhost:3000
# 비밀번호 재설정 메일 링크가 돌아올 주소 (routers/auth.py). 비어 있으면 /auth/forgot-password 가 503.
# Supabase → Authentication → URL Configuration → Redirect URLs 에도 같은 주소를 등록한다
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# ── Claude API (Codyssey 게이트웨이) ── ※ 팀 공용 키 (sk-cody… 로 시작)
# 주소를 빼먹으면 api.anthropic.com 으로 가서 401 이 난다.
# 모델 이름은 날짜 없는 형태만 받는다 — 날짜를 붙이면 "API key is invalid" 로 거절된다.
# 쓸 수 있는 모델: claude-sonnet-4 · claude-haiku-4 · claude-opus-4-8
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://copa.codyssey.kr
ANTHROPIC_MODEL=claude-sonnet-4         # 학습 분해 에이전트 (backend/services/llm.py)
ANTHROPIC_HAIKU_MODEL=claude-haiku-4    # 추천 이유처럼 짧은 문장

# ── Supabase (DB + Auth) ── ※ 팀 공용
SUPABASE_URL=
SUPABASE_ANON_KEY=          # 프론트에서 쓰는 공개 키
SUPABASE_SERVICE_ROLE_KEY=  # 백엔드 전용, 절대 프론트 노출 금지
DATABASE_URL=               # PostgreSQL 직접 연결용

# ── 배치 (Make·cron 이 부르는 무인 API) ──
# POST /plan/nightly (매일 03:00 야간 재조정) 는 로그인 대신 X-Batch-Key 헤더로 이 값을 확인한다.
# 비어 있으면 배치를 실행하지 않는다(503). 아무도 추측 못 할 긴 문자열로 정한다.
BATCH_SECRET=

# 학습 분해 AI 요청 기록(ai_request_logs, migration 015) — 1 이면 저장. 공용 DB 에 015 적용됨(09-29)
AI_REQUEST_METRICS_ENABLED=0

# AI 하루 비용 한도 (달러, 예상치 · backend/services/ai_budget.py). 80% 부터 비회원 AI 추천 차단, 100% 면 새 AI 호출 차단. 0 이면 한도 없음
AI_DAILY_BUDGET_USD=5
# 비회원 한도용 IP 해시에 섞는 값. 비우면 서버를 켤 때마다 새로 만든다 (재시작하면 IP 집계가 이어지지 않을 뿐)
IP_HASH_SALT=

# ── 위비티 수집 ──
# 사용 허락을 확인하기 전에는 false로 유지한다.
WEVITY_CRAWLING_ENABLED=false
# 분야 8개 목록 → 새 공고 상세(마감일·주최·분야·응모대상) · 한 번에 상세 최대 100건 · 요청 사이 3초 · robots.txt 확인

# ── Google OAuth (캘린더 '바쁜 시간' 읽기, FR-PLAN-01 · backend/routers/google_calendar.py) ── ※ 팀 공용
# 구글 로그인과 같은 OAuth 클라이언트를 써도 된다. 비어 있으면 '캘린더에서 가져오기' 버튼이 준비 중으로 안내한다(503)
# 구글 콘솔 '승인된 리디렉션 URI'에 FRONTEND_ORIGIN + /calendar/callback 을 등록한다 (로컬: http://localhost:3000/calendar/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
