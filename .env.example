# ============================================
# StudyPace — 환경변수 템플릿
# 사용법: 이 파일을 복사해 .env 로 만들고 값을 채운다
#   $ cp .env.example .env
# 주의: .env 는 절대 커밋하지 않는다 (.gitignore가 막고 있음)
# ============================================

# ── 앱 기본 설정 ──
APP_ENV=development          # development / production
PORT=8000                   # FastAPI 서버 포트

# ── CORS (프론트 도메인 허용 목록) ──
# 로컬 개발 시 Next.js 기본 포트. 배포 후 Vercel 주소 추가
FRONTEND_ORIGIN=http://localhost:3000

# ── Claude API (Codyssey 게이트웨이) ── ※ 팀 공용 키 (sk-cody… 로 시작)
# 주소를 빼먹으면 api.anthropic.com 으로 가서 401 이 난다.
# 모델 이름은 날짜 없는 형태만 받는다 — 날짜를 붙이면 "API key is invalid" 로 거절된다.
# 쓸 수 있는 모델: claude-sonnet-4 · claude-haiku-4 · claude-opus-4-8
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://copa.codyssey.kr
ANTHROPIC_MODEL=claude-sonnet-4

# ── Supabase (DB + Auth + pgvector) ── ※ 팀 공용
SUPABASE_URL=
SUPABASE_ANON_KEY=          # 프론트에서 쓰는 공개 키
SUPABASE_SERVICE_ROLE_KEY=  # 백엔드 전용, 절대 프론트 노출 금지
DATABASE_URL=               # PostgreSQL 직접 연결용

# ── Google OAuth (캘린더 시간대 읽기) ── ※ 팀 공용
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 리디렉션 URI — 로컬·배포 양쪽 다 등록해야 함 (로드맵 6-③)
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback