{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studypace-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "studypace-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--port", "8000"],
      "cwd": "backend",
      "port": 8000
    }
  ]
}
